# ------------------------------------------------------------------
# RankForge environment template. Copy to .env and fill real values.
# ------------------------------------------------------------------

# SQLite (development) or PostgreSQL (production).
# To use PostgreSQL:
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. DATABASE_URL="postgresql://user:pass@host:5432/rankforge"
#   3. npm run db:migrate && npm run db:seed
DATABASE_URL="file:./dev.db"

# 32+ byte random hex string. Rotating it invalidates all sessions/tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PEPPER=""

# Public base URL, e.g. https://rankforge.example.com
APP_URL="http://localhost:3000"

# Mark emails verified at registration without sending mail. Dev only.
AUTH_AUTO_VERIFY_EMAIL="false"
# Return verification/reset links in API responses. DEV ONLY - keep false in production.
AUTH_DEV_EXPOSE_TOKENS="false"

# Grace window (seconds) for answer saves that are in flight when the
# server-side deadline is reached.
DEADLINE_GRACE_SECONDS="2"

# Attempt sweeper (finalises expired attempts).
SWEEPER_ENABLED="true"
SWEEPER_INTERVAL_MS="60000"
SWEEP_TOKEN=""

# Seed content. Demo users/attempts are labelled isDemo=true.
SEED_DEMO_DATA="false"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# ------------------------------------------------------------------
# Optional integrations (not enabled by default). RankForge ships a safe
# integration boundary in src/lib/mail.ts and src/lib/proctoring.ts.
# ------------------------------------------------------------------
# SMTP_URL=""
# MAIL_FROM="RankForge <no-reply@example.com>"
# PROCTORING_PROVIDER=""
